# Copiar como .env:  cp .env.example .env   (en Windows: copy .env.example .env)

# Contraseña de la base de datos.
# OJO: si ya tienes un volumen pgdata creado con otra contraseña, usa ESA misma
# (en el compose original era "tu_password_seguro"), o la base no conectará.
POSTGRES_PASSWORD=cambia_esta_password

# Puerto del frontend (80 por defecto; usa 8080 si el 80 está ocupado)
WEB_PORT=80
